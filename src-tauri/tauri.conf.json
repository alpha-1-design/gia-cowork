{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GIA Cowork",
  "version": "2.4.0",
  "identifier": "studio.alpha1.gia.cowork",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GIA Cowork",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "rpm"],
    "resources": {
      "sidecars/whatsapp-bridge/src/*": "sidecars/whatsapp-bridge/src/",
      "sidecars/whatsapp-bridge/package.json": "sidecars/whatsapp-bridge/package.json",
      "sidecars/whatsapp-bridge/package-lock.json": "sidecars/whatsapp-bridge/package-lock.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
